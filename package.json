{
  "name": "todo-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker build -t to-do-backend .",
    "docker:run": "docker run --env-file .env -p 3000:3000 --name to-do-backend to-do-backend",
    "docker:dev": "docker run --env-file .env -p 3000:3000 -v \"$(pwd)\":/to-do-backend -v /to-do-backend/node_modules --name to-do-backend-dev to-do-backend",
    "docker:stop": "docker stop to-do-backend; docker rm to-do-backend"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
